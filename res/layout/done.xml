<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">
  <RelativeLayout android:id="@+id/Bar2" android:background="@drawable/greenbar" android:layout_height="wrap_content" android:layout_width="fill_parent">
    <LinearLayout android:id="@+id/LinearLayout01" android:focusableInTouchMode="true" android:focusable="true" android:layout_width="wrap_content" android:layout_height="wrap_content">
      <ImageView android:id="@+id/IconView1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/icon" android:maxWidth="48px" android:maxHeight="48px" android:layout_marginLeft="10px" android:layout_marginTop="5px"></ImageView>
      <TextView android:id="@+id/TextView01" android:layout_below="@id/IconView1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dream Provisioner" android:layout_marginLeft="10px" android:textStyle="bold" android:minWidth="131px" android:layout_marginTop="20px" android:textColor="#FFFFFF"></TextView>
    </LinearLayout>
  </RelativeLayout>
  <ScrollView android:id="@+id/ScrollView01" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/LinearLayout02" android:layout_below="@id/LinearLayout01" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:scrollbarAlwaysDrawVerticalTrack="true" android:scrollbars="vertical">
      <TextView android:id="@+id/DoneText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#000000" android:layout_margin="10px" android:gravity="center" android:layout_gravity="center" android:text="The Device has been provisioned. You can now open the proper Home launcher."></TextView>
      <Button android:id="@+id/OpenLauncher" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Open launcher" android:layout_width="160px"></Button>
      <TextView android:id="@+id/WillClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#000000" android:layout_margin="10px" android:textStyle="bold" android:gravity="center" android:layout_gravity="center" android:text="The setup wizard has been killed, however it has not been disabled, so after boot or when pressing Home, it will be opened instead of the launcher.\n\n"></TextView>
      <TextView android:id="@+id/WillClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#000000" android:layout_margin="10px" android:gravity="center" android:layout_gravity="center" android:text="To fully bypass the setup, you should root your phone and either disable 'com.android.setupwizard.SetupWizardActivity', or delete/rename '/system/app/SetupWizard.apk'.\n\nYou should then be able to use your handset normally.\n\n\n"></TextView>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
